#!/bin/sh
# Starts the dashboard at boot if /mnt/us/dashboard/AUTOSTART exists.
# Runs early (rcS), long before the Kindle UI is up, so it waits in the
# background until the UI has started and settled, then takes over the screen.
LOG=/mnt/us/dashboard/dashboard.log
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') boot: $*" >> $LOG 2>/dev/null; }

case "$1" in
    start)
        [ -f /mnt/us/dashboard/AUTOSTART ] || exit 0
        (
            trap '' HUP
            log "autostart: waiting for the Kindle UI"
            i=0
            while ! pidof cvm >/dev/null 2>&1 && [ $i -lt 300 ]; do sleep 5; i=$((i + 5)); done
            if pidof cvm >/dev/null 2>&1; then log "Kindle UI up after ${i}s"; else log "Kindle UI not up after ${i}s"; fi
            # let the UI finish loading and wifi connect before stopping it
            sleep 45
            log "starting dashboard"
            sh /mnt/us/dashboard/dashboard.sh start
        ) </dev/null >/dev/null 2>&1 &
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac
exit 0
