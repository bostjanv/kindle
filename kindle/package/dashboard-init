#!/bin/sh
# Starts the dashboard at boot if /mnt/us/dashboard/AUTOSTART exists.
case "$1" in
    start)
        if [ -f /mnt/us/dashboard/AUTOSTART ]; then
            # give the framework and wifi time to come up first
            ( sleep 90; sh /mnt/us/dashboard/dashboard.sh start ) >/dev/null 2>&1 &
        fi
        ;;
    stop)
        [ -f /var/run/dashboard.pid ] && kill "$(cat /var/run/dashboard.pid)" 2>/dev/null
        rm -f /var/run/dashboard.pid
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac
exit 0
