# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp kindle-dash.service ~/.config/systemd/user/
#   edit WorkingDirectory below, then:
#   systemctl --user daemon-reload && systemctl --user enable --now kindle-dash
#   loginctl enable-linger $USER     # keep running when logged out
[Unit]
Description=Kindle e-ink dashboard server
After=network-online.target

[Service]
WorkingDirectory=%h/dev/kindle/server
ExecStart=%h/dev/kindle/server/.venv/bin/python -m kindle_dash serve -c config.toml
Restart=on-failure

[Install]
WantedBy=default.target
